# Database Configuration
# In Local Development: leave DATABASE_URL blank or commented out to use local SQLite (backend/woodora.db)
# In Production: set your managed PostgreSQL connection string
# Examples:
#   DATABASE_URL=postgresql://woodora_user:StrongPassword123@db.project.supabase.co:5432/postgres
#   DATABASE_URL=postgresql://user:password@localhost:5432/woodoradb
DATABASE_URL=

# Gemini AI API Key (required for live architectural furniture recommendations)
GEMINI_API_KEY=

# Platform Administrator Credentials (initialized on first boot)
ADMIN_NAME=Woodora Administrator
ADMIN_EMAIL=admin@woodora.com
ADMIN_PASSWORD=WoodoraAdmin2026!
